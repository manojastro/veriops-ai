# Copy to .env and adjust. Never commit real secrets.

# --- runtime ---
APP_ENV=local
LOG_LEVEL=INFO

# --- storage ---
DATABASE_URL=postgresql+psycopg://veriops:veriops@localhost:5432/veriops
REDIS_URL=redis://localhost:6379/0

# --- execution ---
EXECUTION_MODE=inprocess            # inprocess | worker (Redis queue)
TELEMETRY_BACKEND=http              # http (simulator service) | inprocess
SIMULATOR_URL=http://localhost:8100

# --- LLM (default: deterministic simulated provider, no key needed) ---
LLM_PROVIDER=simulated              # simulated | openai | azure_openai | anthropic | openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=                    # for openai_compatible (e.g. a local vLLM/Ollama endpoint)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=            # strong model deployment (reasoning)
AZURE_OPENAI_DEPLOYMENT_SMALL=      # cheap model deployment (classification/summaries)
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=gpt-4.1-mini
LLM_MODEL_MEDIUM=gpt-4.1
LLM_MODEL_LARGE=gpt-4.1
LLM_PRICING_OVERRIDES=              # JSON: {"model": [usd_per_mtok_in, usd_per_mtok_out]}

# --- embeddings ---
EMBEDDING_PROVIDER=hashing          # hashing | openai | azure_openai
EMBEDDING_MODEL=text-embedding-3-small

# --- bounded loops ---
MAX_INVESTIGATION_ITERATIONS=5
MAX_REMEDIATION_ATTEMPTS=3
MAX_TOOL_RETRIES=3
MAX_LLM_RETRIES=2
TOOL_TIMEOUT_SECONDS=10

# --- security ---
JWT_SECRET=                         # REQUIRED outside local development (long random string)
SEED_DEMO_USERS=true                # must be false in production
DEMO_USER_PASSWORD=veriops-demo
RATE_LIMIT_PER_MINUTE=120

# --- observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- evaluation gates ---
EVAL_MIN_ROOT_CAUSE_ACCURACY=0.8
EVAL_MIN_UNSAFE_REJECTION_RATE=1.0
